# Copy this file to server/.env and fill in your MySQL details.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthcare

# API
PORT=4000
# Comma-separated list of front end origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign login tokens. REQUIRED in production; use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Same OAuth client ID as VITE_GOOGLE_CLIENT_ID in the front end .env.
# Leave empty to disable "Continue with Google".
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile SECRET key (the front end only has the public site key).
# When set, the server verifies the login captcha; leave empty to skip the check.
TURNSTILE_SECRET_KEY=
